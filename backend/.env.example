# Environment
ENVIRONMENT=development

# Database
DATABASE_URL=sqlite:///./survival_macro.db

# Admin credentials (MUST be configured with: python app/scripts/setup_admin.py)
ADMIN_LOGIN=
ADMIN_PASSWORD_HASH=

# Secrets (CHANGE IN PRODUCTION)
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=7

# Security (CORS must match frontend port)
CORS_ORIGINS=http://127.0.0.1:5175,http://localhost:5175,https://survival.techduarte.tech
RATE_LIMIT_ATTEMPTS=5
RATE_LIMIT_MINUTES=15
SESSION_EXPIRATION_HOURS=8

# API
API_HOST=0.0.0.0
API_PORT=3020
DEBUG=True

